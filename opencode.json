{
  "model": "opencode/kimi-k2.5",
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    ".cursor/rules/*.md"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "qwen2.5-coder:14b"
        },
        "qwen3-coder:30b-a3b-q4_K_M": {
          "name": "qwen3-coder:30b-a3b-q4_K_M"
        },
        "llama3.1:8b": {
          "name": "llama3.1:8b"
        },
        "qwen3:8b": {
          "name": "qwen3:8b"
        }
      }
    }
  },
  "agent": {
    "Ask": {
      "model": "opencode/kimi-k2.5",
      "tools": {
        "bash": false,
        "edit": false
      }
    },
    "security": {
      "model": "opencode/big-pickle",
      "tools": {
        "bash": false,
        "edit": false
      }
    }
  },
  "plugin": [
    "oh-my-opencode@3.10.0",
    "opencode-cursor-auth@1.0.16"
  ],
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
